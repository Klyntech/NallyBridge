# NallyBridge Configuration
# Copy to .env and fill in values

# NALLY server connection (required)
NALLY_HOST=your-app.onrender.com
NALLY_BRIDGE_TOKEN=your-bridge-secret-token
NALLY_USE_SSL=true

# Device identity (required — unique per machine)
NALLY_DEVICE_NAME=desktop

# Execution limits (optional)
NALLY_CMD_TIMEOUT=60
NALLY_FILE_READ_MAX=1048576

# Reconnection (optional)
NALLY_RECONNECT_BASE=2
NALLY_RECONNECT_MAX=60
NALLY_PING_INTERVAL=30

# Logging (optional)
NALLY_LOG_LEVEL=INFO
